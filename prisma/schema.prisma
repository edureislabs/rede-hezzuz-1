// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  nickname              String   @unique
  passwordHash          String
  emailVerified         Boolean  @default(false)
  verificationCode      String?
  verificationExpires   DateTime?
  resetCode             String?
  resetExpires          DateTime?
}